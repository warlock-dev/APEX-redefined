rules_version = '2';

// Each person can read and write only their own data, under users/{their uid}/.
// Only the four APEX collections are allowed, ids must be simple, and documents cannot be deleted
// (APEX marks things deleted instead, so the other devices learn about it).
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{collection}/{id} {
      function ownsIt() {
        return request.auth != null && request.auth.uid == uid;
      }
      function allowedCollection() {
        return collection in ['tracks', 'nodes', 'tasks', 'days'];
      }
      function simpleId() {
        return id.matches('^[A-Za-z0-9_-]{1,64}$');
      }

      allow read: if ownsIt() && allowedCollection() && simpleId();
      allow create, update: if ownsIt() && allowedCollection() && simpleId()
        && request.resource.data.id == id
        && request.resource.data.keys().size() <= 40;
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
